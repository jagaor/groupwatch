# Configuración de GroupWatch
# Copia este fichero a .env y rellena los valores reales.
# Nunca subas el .env con credenciales a un repositorio.

# Host del controlador de dominio o servidor LDAP al que conectarse.
LDAP_HOST=ldap.ejemplo.local

# Puerto del servicio LDAP (389 para LDAP, 636 para LDAPS).
LDAP_PORT=389

# DN de la cuenta de servicio usada para el bind contra Active Directory.
LDAP_BIND_DN=CN=svc-groupwatch,OU=ServiceAccounts,DC=ejemplo,DC=local

# Contraseña de la cuenta de servicio. No la hardcodees en el código.
LDAP_BIND_PASSWORD=TU_PASSWORD_AQUI

# DN base desde el que se realizan las búsquedas de grupos y miembros.
LDAP_BASE_DN=DC=ejemplo,DC=local

# Token del bot de Telegram obtenido de @BotFather.
TELEGRAM_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Identificador del chat o canal donde se envían las alertas.
TELEGRAM_CHAT_ID=-1001234567890

# Grupos privilegiados a vigilar, separados por comas.
GROUPS=Domain Admins,Enterprise Admins,Schema Admins

# Intervalo de sondeo en segundos entre cada ciclo de comparación.
POLL_INTERVAL=60
